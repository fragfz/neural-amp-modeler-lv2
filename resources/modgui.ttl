@prefix modgui: <http://moddevices.com/ns/modgui#>.
@prefix lv2:    <http://lv2plug.in/ns/lv2core#>.

# GUI description for the TCDE build (cab + DC blocker + EQ). This is a
# static file on purpose: the mod-plugin-builder recipe installs it straight
# from the source tree, so it must not contain any @configure_file@
# placeholders. Only the basic level/quality knobs are exposed; the cab,
# EQ and out_calibrated parameters are not shown in the MOD GUI.
<http://github.com/fragfz/neural-amp-modeler-lv2_tcde>
    modgui:gui [
        modgui:resourcesDirectory <modgui>;
        modgui:iconTemplate <modgui/icon-nam.html>;
        modgui:stylesheet <modgui/stylesheet-nam.css>;
        modgui:screenshot <modgui/screenshot-nam.png>;
        modgui:thumbnail <modgui/thumbnail-nam.png>;
        modgui:discussionURL <https://forum.mod.audio/t/neural-amp-modeler/10112> ;
        modgui:port [
            lv2:index 0;
            lv2:symbol "input_level";
            lv2:name "Input Lvl";
        ], [
            lv2:index 1;
            lv2:symbol "output_level";
            lv2:name "Output Lvl";
        ], [
            lv2:index 2;
            lv2:symbol "quality_scale";
            lv2:name "Quality";
        ];
    ].
